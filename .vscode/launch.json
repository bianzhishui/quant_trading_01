    "version": "0.2.0",
    "configurations": [
        {
            "name": "daily_update (只读总表)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python", // macOS 路径
            "program": "${workspaceFolder}/research/daily_update.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--table"
            ]
        },
        {
            "name": "paper_live report",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/research/paper_live.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "report"
            ]
        }
    ]
}
